# Frontend Configuration

# Backend API Base URL
# For local development, use localhost
# For production, use your Render backend URL
VITE_API_BASE_URL=http://localhost:5000/api

# Production Backend URL (Update this after deploying to Render)
# VITE_API_BASE_URL=https://your-backend-name.onrender.com/api

# Backend URL for Vite Proxy (Local Development Only)
# This is used by vite.config.ts for the proxy target
VITE_BACKEND_URL=http://localhost:5000

# Optional: Custom media/asset URLs
# VITE_MEDIA_BASE_URL=http://localhost:5000/media

# Google OAuth Client ID (Optional)
VITE_GOOGLE_CLIENT_ID=1035830264645-6u52dun8ipjcopmai0s9qlv2knfknamd.apps.googleusercontent.com
